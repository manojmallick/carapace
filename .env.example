# Read path (agent process): SELECT-only carapace_reader role.
# Multiple hosts = client-side failover across cluster nodes.
CARAPACE_DB_READ_URL=postgresql://carapace_reader@localhost:26251,localhost:26252,localhost:26253/carapace?sslmode=disable

# Write path (Lambda / local write-back ONLY -- never the agent):
CARAPACE_DB_WRITE_URL=postgresql://carapace_writer@localhost:26251,localhost:26252,localhost:26253/carapace?sslmode=disable

# Admin, used only by scripts/setup-schema.sh:
CARAPACE_DB_ADMIN_URL=postgresql://root@localhost:26251/carapace?sslmode=disable

AWS_REGION=eu-central-1
CARAPACE_BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
CARAPACE_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# 1 = run the write-back handler locally instead of invoking Lambda:
CARAPACE_LOCAL_WRITEBACK=1
CARAPACE_WRITEBACK_LAMBDA=carapace-writeback
